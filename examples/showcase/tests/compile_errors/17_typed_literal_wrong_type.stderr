  |           $(impl IntoValue<kind::$kind> for $t {
  |             ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
...
  | / into_value!(IntValue:
  | |     i64 => |v| Value::I64(v),
  | |     i32 => |v| Value::I64(v.into()),
  | |     i16 => |v| Value::I64(v.into()),
... |
  | |     isize => |v| Value::I64(v as i64),
  | | );
  | |_- in this macro invocation
  = help: for that trait implementation, expected `IntValue`, found `StringValue`
